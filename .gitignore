# MementoBloom - Secure .gitignore
# Proyecto mutable con contexto privado - NO subir credenciales ni datos de sesión

# === CREDENTIALS & SECRETS (CRITICAL) ===
~/.memento/vault.json
.memento/
.memento/vault.json
.env
*.env
.env.local
.env.dev
.env.prod
*.env.*
!.env.example

# === SESSION, CONTEXT & RUNTIME DATA (DO NOT UPLOAD) ===
session_record.json
sessions/
memory/
.memento_runtime/
uploads/
<body>.html
*HANDOFF*.md
*_CONTEXT.md
.agent_context/START_CONTEXT.md
.agent_context/USER_CONTEXT.md

# === AGENT FILES ===
.agent_context/agent/memento-curador.md
.agent_context/agent/memento-onboarding.md
.agent_context/agent/agent-main.md
.agent_context/secure/
.panel_messages.json
.chat_waiter_state.json
tools/secure_context.py

# === ARCHIVE PRESERVATION (LOCAL ONLY) ===
archive/
etl/

# === CONFIG WITH LOCAL PATHS ===
config.json

# === PYTHON ARTIFACTS ===
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
*.pyd

# === VIRTUAL ENVIRONMENT ===
venv/
ENV/
env/
.venv

# === OS METADATA ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.fseventsd
.fsattributes

# === IDE / EDITOR ===
.vscode/
.idea/
*.swp
*.swo
*~

# === BUILD ARTIFACTS ===
dist/
build/
*.egg-info/
.eggs

# === NODE MODULES (LOCAL TOOLING ONLY) ===
.agent_context/node_modules/
.agent_context/package-lock.json

# === BACKUPS LOCALES (NO VERSIONAR) ===
.backups/

# === PERSONALIDAD ===
memory/personality/user_personality.md

# === KILO CLI CONFIG (LOCAL ONLY) ===
.kilo/
