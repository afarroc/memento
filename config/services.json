          "port": 6379,
          "type": "local"
        }
      ]
    },
    "mariadb": {
      "description": "MariaDB database server",
      "endpoints": [
        {
          "name": "local",
          "host": "localhost",
          "port": 3306,
          "type": "local"
        }
      ]
    },
    "ssh": {
      "description": "SSH access server",
