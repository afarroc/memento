#!/usr/bin/env bash
set -euo pipefail

MEMENTO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -n "${MEMENTO_WORKSPACE:-}" ]]; then
  ROOT="$MEMENTO_WORKSPACE"
elif [[ -d "$MEMENTO_DIR/.git" ]] && [[ ! -d "$(cd "$MEMENTO_DIR/.." && pwd)/.git" ]]; then
  # Current dir has .git, parent doesn't -> development mode
  ROOT="$MEMENTO_DIR"
else
  # Client mode: parent directory is the workspace
  ROOT="$(cd "$MEMENTO_DIR/.." && pwd)"
fi

AUTO_MODE=0
for arg in "$@"; do
  case "$arg" in
    --auto|-y)
      AUTO_MODE=1
      ;;
  esac
done
export AUTO_MODE

PYTHON_BIN="${PYTHON_BIN:-python3}"
VENV_DIR="${VENV_DIR:-$ROOT/venv}"
REQUIREMENTS="$MEMENTO_DIR/requirements.txt"
AGENT_CMD_FILE="$ROOT/.agent_context/secure/AGENT_CMD.env"
USER_CONTEXT="$ROOT/.agent_context/secure/USER_CONTEXT.md"
ONBOARD_MARKER="$ROOT/.agent_context/secure/ONBOARDED"
AGENT_TEMPLATE_DIR="$MEMENTO_DIR/.agent_context/agent"

log() {
  printf '\n%s\n' "$*"
}

ok() {
  printf 'OK: %s\n' "$*"
}

warn() {
  printf 'WARN: %s\n' "$*"
}

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

confirm() {
  local prompt="$1"
  local default="${2:-y}"
  local answer

  if [[ "$default" == "y" ]]; then
    prompt="$prompt [Y/n]"
  else
    prompt="$prompt [y/N]"
  fi

  if [[ "$AUTO_MODE" -eq 1 ]]; then
    printf '%s -> %s (auto)\n' "$prompt" "$default"
    if [[ "$default" == "y" ]]; then
      return 0
    else
      return 1
    fi
  fi

  printf '%s ' "$prompt"
  read -r answer

  if [[ -z "$answer" ]]; then
    answer="$default"
  fi

  case "$answer" in
    y|Y|yes|YES|s|S) return 0 ;;
    *) return 1 ;;
  esac
}

read_line() {
  local prompt="$1"
  local default="${2:-}"
  local value

  if [[ -n "$default" ]]; then
    printf '%s [%s] ' "$prompt" "$default"
  else
    printf '%s ' "$prompt"
  fi

  if [[ "$AUTO_MODE" -eq 1 ]]; then
    printf '%s (auto)\n' "$default"
    value="$default"
  else
    read -r value
  fi

  if [[ -z "$value" ]]; then
    value="$default"
  fi

  printf '%s\n' "$value"
}

print_header() {
   cat <<'EOF'
MementoBloom Installer

Este instalador asume que el repositorio ya fue clonado.
El único paso indispensable previo es:

  git clone <repo>
  cd <workspace>

El instalador validará dependencias, creará entorno opcional, configurará
contexto local y podrá iniciar el proyecto como agente usando el CLI que elijas.

Si mementobloom está como subdirectorio (cd <workspace>/mementobloom):
  export MEMENTO_WORKSPACE=$(pwd)/..  # El workspace raíz
EOF
}

check_repo() {
  if [[ ! -f "$ROOT/.git/HEAD" ]]; then
    warn "Este directorio no parece ser un repositorio Git clonado."
    warn "El primer paso indispensable es clonar el repositorio y entrar en él."
    exit 1
  fi

  ok "Repositorio detectado: $ROOT"
}

check_python() {
  if command_exists "$PYTHON_BIN"; then
    ok "Python disponible: $("$PYTHON_BIN" --version 2>&1)"
  else
    warn "No se encontró '$PYTHON_BIN'. Python 3 es obligatorio para MementoBloom."
    exit 1
  fi
}

setup_venv() {
  if [[ -x "$ROOT/venv/bin/python" ]]; then
    ok "Entorno virtual existente: $ROOT/venv"
    PYTHON_BIN="$ROOT/venv/bin/python"
    return 0
  fi

  if confirm "¿Crear entorno virtual en '$ROOT/venv'?" "y"; then
    "$PYTHON_BIN" -m venv "$ROOT/venv"
    PYTHON_BIN="$ROOT/venv/bin/python"
    ok "Entorno virtual creado: $ROOT/venv"
  else
    warn "Se usará Python del sistema: $PYTHON_BIN"
  fi
}

install_requirements() {
  if [[ ! -f "$REQUIREMENTS" ]]; then
    warn "No se encontró $REQUIREMENTS; se omite instalación de dependencias Python."
    return 0
  fi

  if confirm "¿Instalar dependencias de $REQUIREMENTS?" "y"; then
    "$PYTHON_BIN" -m pip install --upgrade pip
    "$PYTHON_BIN" -m pip install -r "$REQUIREMENTS"
    ok "Dependencias Python instaladas"
  else
    warn "Instalación de dependencias omitida."
  fi
}

install_mementobloom_package() {
  if [[ ! -d "$MEMENTO_DIR" ]]; then
    warn "No se encontró el directorio fuente de mementobloom en $MEMENTO_DIR"
    return 1
  fi

  local venv_pip="$VENV_DIR/bin/pip"
  if [[ ! -x "$venv_pip" ]]; then
    warn "No se encontró pip en $venv_pip; instala el venv primero."
    return 1
  fi

  if confirm "¿Instalar mementobloom como paquete editable en el venv del cliente?" "y"; then
    "$venv_pip" install -e "$MEMENTO_DIR"
    ok "Paquete mementobloom instalado en $VENV_DIR"
  else
    warn "Instalación del paquete mementobloom omitida."
  fi
}

create_client_wrappers() {
   local bin_dir="$ROOT/.memento/bin"
   mkdir -p "$bin_dir"

   local modules=("bootstrap_context" "doctor" "selftest" "quick_scan" "context_builder" "session_start" "optimize_agent" "export_memory" "init_project" "clean_workspace")
   for mod in "${modules[@]}"; do
     local wrapper="$bin_dir/memento-$mod"
     cat > "$wrapper" <<EOSCRIPT
#!/bin/bash
set -euo pipefail
SCRIPT_DIR="\$(cd "\$(dirname "\${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="\$(cd "\$SCRIPT_DIR/../.." && pwd)"
export MEMENTO_WORKSPACE="\$ROOT_DIR"
if [[ -x "\$ROOT_DIR/venv/bin/python" ]]; then
  exec "\$ROOT_DIR/venv/bin/python" -m tools.$mod "\$@"
else
  exec python3 -m tools.$mod "\$@"
fi
EOSCRIPT
     chmod +x "$wrapper"
   done

   ok "Wrappers creados en $bin_dir"
 }

ensure_agent_context_dirs() {
   mkdir -p "$ROOT/.agent_context/secure"
   mkdir -p "$ROOT/.memento/memory/graph"
   mkdir -p "$ROOT/.memento/bin"
   ok "Directorio de contexto local listo: $ROOT/.agent_context"
}

cleanse_inherited_data() {
   log "Saneamiento de instalación limpia: eliminando datos heredados"
   local cleansed=0

   if [[ -d "$ROOT/projects" ]]; then
      find "$ROOT/projects" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null || true
      ok "Directorio projects/ saneado (datos heredados eliminados)"
      cleansed=1
   fi

   if [[ -d "$ROOT/memory" ]]; then
      rm -rf "$ROOT/memory"
      mkdir -p "$ROOT/memory/graph"
      echo '{}' > "$ROOT/memory/graph/memory_index.json"
      ok "Memoria reinicializada en estado vacío (amnesia limpia)"
      cleansed=1
   fi

   if [[ -d "$ROOT/.memento" ]]; then
      rm -rf "$ROOT/.memento"
      mkdir -p "$ROOT/.memento/memory/graph"
      ok "Directorio .memento/ saneado"
      cleansed=1
   fi

   if [[ -d "$ROOT/.memento_runtime" ]]; then
      rm -rf "$ROOT/.memento_runtime"
      cleansed=1
   fi

   if [[ -d "$ROOT/uploads" ]]; then
      rm -rf "$ROOT/uploads"
      cleansed=1
   fi

   if [[ $cleansed -eq 0 ]]; then
      ok "No se detectaron datos heredados para limpiar"
   fi
}

configure_user_context() {
  if [[ -f "$USER_CONTEXT" ]]; then
    ok "Contexto de usuario existente: $USER_CONTEXT"
    if confirm "¿Editar contexto de usuario ahora?" "n"; then
      "${EDITOR:-vi}" "$USER_CONTEXT"
    fi
    return 0
  fi

  log "Contexto de usuario no encontrado: $USER_CONTEXT"
  if confirm "¿Crear un contexto básico de usuario?" "y"; then
    cat > "$USER_CONTEXT" <<'EOF'
# Contexto de Usuario MementoBloom

Actualizado: $(date -Iseconds)

## Preferencias de comunicación
- Idioma principal: español.
- Estilo preferido: directo, técnico y orientado a acción.

## Objetivo del usuario
- Continuar sesiones con contexto reconstruido desde archivos locales.

## Infraestructura
- Workspace: pendiente de configurar.

## Reglas operativas
- No pedir datos ya registrados.
- Continuar desde el último handoff relevante.
- No trackear contexto local regenerable.
EOF
    sed -i '' "s/\$(date -Iseconds)/$(date -Iseconds)/" "$USER_CONTEXT" 2>/dev/null || \
      sed -i "s/\$(date -Iseconds)/$(date -Iseconds)/" "$USER_CONTEXT"
    warn "Edita este archivo cuando quieras personalizar usuario, infraestructura o reglas."
  else
    warn "Contexto de usuario no creado. El proyecto seguirá funcionando sin él."
  fi
}

detect_agent_cli() {
  log "Detección de CLI/agente externo"
  local detected=""
  if command_exists "kilo"; then
    detected="kilo"
    ok "CLI detectado: kilo ($(command -v kilo))"
  elif command_exists "claude"; then
    detected="claude"
    ok "CLI detectado: claude ($(command -v claude))"
  elif command_exists "code"; then
    detected="code"
    ok "CLI detectado: code ($(command -v code))"
  else
    warn "No se detectó ningún CLI de agente conocido."
  fi

  if [[ -n "$detected" ]]; then
    if [[ "$AUTO_MODE" -eq 1 ]]; then
      printf '%s\n' "$detected"
      return 0
    fi
    if confirm "¿Usar '$detected' como CLI de agente?" "y"; then
      printf '%s\n' "$detected"
      return 0
    fi
  fi

  return 1
}

select_agent() {
  if [[ -f "$ONBOARD_MARKER" ]]; then
    printf 'agent-main\n'
    return 0
  fi

  if [[ "$AUTO_MODE" -eq 1 ]]; then
    printf 'agent-main\n'
    return 0
  fi

  if confirm "¿Ejecutar agente de configuración inicial (solo primera vez)?" "y"; then
    printf 'agent-onboarding\n'
  else
    printf 'agent-main\n'
  fi
}

setup_agent_files() {
  if [[ ! -d "$AGENT_TEMPLATE_DIR" ]]; then
    warn "No se encontraron plantillas de agente en $AGENT_TEMPLATE_DIR."
    return 1
  fi

  if [[ -f "$AGENT_TEMPLATE_DIR/agent-main.md" ]]; then
    cp -n "$AGENT_TEMPLATE_DIR/agent-main.md" "$AGENT_TEMPLATE_DIR/memento-curador.md" 2>/dev/null || true
  fi

  if [[ -f "$AGENT_TEMPLATE_DIR/agent-onboarding.md" ]]; then
    cp -n "$AGENT_TEMPLATE_DIR/agent-onboarding.md" "$AGENT_TEMPLATE_DIR/memento-onboarding.md" 2>/dev/null || true
  fi
}

select_agent() {
  if [[ -f "$ONBOARD_MARKER" ]]; then
    printf 'agent-main\n'
    return 0
  fi

  if confirm "¿Ejecutar agente de configuración inicial (solo primera vez)?" "y"; then
    printf 'agent-onboarding\n'
  else
    printf 'agent-main\n'
  fi
}

configure_agent_command() {
  log "Configuración del agente/CLI externo"
  printf '1) Usar un CLI detectado (kilo, claude, code...)\n'
  printf '2) Ingresar comando personalizado del agente\n'
  printf '3) No configurar agente ahora; solo preparar contexto\n'

  if [[ "$AUTO_MODE" -eq 1 ]]; then
    local cli=""
    cli="$(detect_agent_cli || true)"
    if [[ -n "$cli" ]]; then
      printf 'Auto-seleccionando opción 1 (CLI detectado: %s)\n' "$cli"
      option="1"
    else
      printf 'Auto-seleccionando opción 3 (sin CLI detectado)\n'
      option="3"
    fi
  else
    option="$(read_line "Opción" "1")"
  fi

  case "$option" in
    1)
      setup_agent_files || warn "No se pudieron preparar las plantillas de agente."
      local agent
      agent="$(select_agent)"

      local cli
      cli="$(detect_agent_cli)"
      local flags=""
      if [[ "$cli" == "kilo" ]]; then
        flags=" --agent '$agent'"
      fi

      local model="${MEMENTO_MODEL:-}"
      local model_flag=""
      if [[ -n "$model" ]]; then
        model_flag=" --model '$model'"
      fi

local cmd="$cli run --dir '$ROOT'${flags}${model_flag} --auto \"\$(MEMENTO_WORKSPACE='$ROOT' python3 $MEMENTO_DIR/tools/bootstrap_context.py --print)\""
       printf '%s\n' "$cmd" > "$AGENT_CMD_FILE"
      export MEMENTO_AGENT_CMD="$cmd"
      ok "Comando de agente guardado en $AGENT_CMD_FILE"
      ok "CLI seleccionado: ${cli:-ninguno detectado}"
      ok "Agente seleccionado: $agent"
      ;;
    2)
      printf 'Escribe el comando completo que inicia tu agente. Ejemplo:\n'
      printf '  <cli> run --dir . -i "$(python3 tools/bootstrap_context.py --print)"\n'
      local cmd
      cmd="$(read_line "Comando MEMENTO_AGENT_CMD" "")"
      if [[ -z "$cmd" ]]; then
        warn "No se configuró comando de agente."
        return 0
      fi
      printf '%s\n' "$cmd" > "$AGENT_CMD_FILE"
      export MEMENTO_AGENT_CMD="$cmd"
      ok "Comando de agente guardado en $AGENT_CMD_FILE"
      ;;
    *)
      warn "No se configuró agente. Podrás ejecutar ./memento-start más tarde."
      ;;
  esac
}

start_services_optional() {
   if ! confirm "¿Verificar/iniciar servicios locales opcionales (sala/Redis)?" "n"; then
     return 0
   fi

   if [[ -f "$MEMENTO_DIR/tools/sala.py" ]]; then
     "$PYTHON_BIN" "$MEMENTO_DIR/tools/session_start.py" --services-only
   else
     warn "tools/sala.py no existe; no se pueden iniciar servicios de sala."
   fi
 }

prepare_context() {
   log "Preparando contexto local de sesión"
   MEMENTO_WORKSPACE="$ROOT" "$PYTHON_BIN" "$MEMENTO_DIR/tools/session_start.py" --print --no-services --limit 14
 }

launch_agent_optional() {
  if [[ -z "${MEMENTO_AGENT_CMD:-}" ]]; then
    warn "No hay MEMENTO_AGENT_CMD configurado; no se lanzará agente."
    return 0
  fi

  if ! confirm "¿Lanzar ahora el agente configurado?" "y"; then
    return 0
  fi

  "$PYTHON_BIN" "$MEMENTO_DIR/tools/session_start.py" --print --no-services --limit 14 --launch-agent
}

print_next_steps() {
   cat <<EOF

 Próximos comandos útiles (ejecuta desde la raíz del cliente):

   ./memento-start --quick --limit 8
   ./memento-start --print --no-services --limit 14
   ./memento-start --services --launch-agent

 O usa los comandos de la toolbelt (después de activar el venv o desde \$PATH):

   memento-bootstrap --print
   memento-doctor --startup
   memento-selftest
   memento-quick-scan <PATH>
   memento-session-start --prepare-seed

 Si editaste .agent_context/secure/AGENT_CMD.env manualmente, recárgalo así:

   export MEMENTO_AGENT_CMD="\$(cat .agent_context/secure/AGENT_CMD.env)"

 Nota: mementobloom está instalado como paquete editable en el venv del cliente.
 Los ejecutables están en .memento/bin/ y venv/bin/.
 El código fuente de mementobloom/ está ignorado en .gitignore del cliente.
EOF
}

create_client_start_script() {
  local script_path="$ROOT/memento-start"
  if [[ -f "$script_path" ]]; then
    ok "Script de inicio de cliente ya existe: $script_path"
    return 0
  fi

  cat > "$script_path" <<'EOSCRIPT'
#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MEMENTO_DIR="$SCRIPT_DIR/mementobloom"
export MEMENTO_WORKSPACE="$SCRIPT_DIR"

cd "$MEMENTO_DIR"
exec python3 tools/session_start.py "$@"
EOSCRIPT

  chmod +x "$script_path"
  ok "Script de inicio de cliente creado: $script_path"
}

update_client_gitignore() {
  local gitignore="$ROOT/.gitignore"
  local entries=(
    ".agent_context/secure/"
    ".agent_context/START_CONTEXT.md"
    "memory/"
    "projects/"
    ".memento/"
    "venv/"
    "mementobloom/"
    "*.pyc"
    "__pycache__/"
    ".env"
  )

  if [[ ! -f "$gitignore" ]]; then
    : > "$gitignore"
  fi

  local current
  current="$(grep -E -v '^$|^#' "$gitignore" || true)"

  local added=0
  for entry in "${entries[@]}"; do
    if ! grep -qxF "$entry" "$gitignore" 2>/dev/null; then
      echo "$entry" >> "$gitignore"
      added=$((added + 1))
    fi
  done

  if [[ $added -gt 0 ]]; then
    ok "Actualizado $gitignore (+$added reglas)"
  else
    ok "$gitignore ya contenía las reglas de exclusión"
  fi
}

main() {
  print_header
  check_repo
  check_python
  ensure_agent_context_dirs
  cleanse_inherited_data
  setup_venv
  install_requirements
  install_mementobloom_package
  create_client_wrappers
  configure_user_context
  configure_agent_command
  update_client_gitignore
  create_client_start_script
  start_services_optional
  prepare_context
  launch_agent_optional
  print_next_steps
}

main "$@"
