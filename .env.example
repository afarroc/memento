# MementoBloom environment example.
# Copy to .env and fill only on local machines. Do not commit .env.

# Management360 API configuration
M360_BASE_URL=http://127.0.0.1:8000
M360_USERNAME=su
M360_PASSWORD=
M360_TIMEOUT=60
M360_CSRF_ENDPOINT=/api/csrf/
M360_API_KEY=

# Termux SSH used by panel_server.py for Redis/SD commands.
# Prefer TERMUX_SSH_PASSWORD only for local development.
# Production/local secure usage: store TERMUX_SSH_PASSWORD in ~/.memento/vault.json
# as secret key "termux_ssh_password".
TERMUX_SSH_HOST=192.168.18.59
TERMUX_SSH_PORT=8022
TERMUX_SSH_USER=u0_a212
TERMUX_SSH_PASSWORD=
