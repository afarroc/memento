# MementoBloom environment example.
# Copy to .env and fill only on local machines. Do not commit .env.

# Management360 API configuration
M360_BASE_URL=http://127.0.0.1:8000
M360_USERNAME=su
M360_PASSWORD=
M360_TIMEOUT=60
M360_CSRF_ENDPOINT=/api/csrf/
M360_API_KEY=

# Termux SSH used by panel_server.py for Redis/SD commands.
# Prefer TERMUX_SSH_PASSWORD only for local development.
# Production/local secure usage: store TERMUX_SSH_PASSWORD in ~/.memento/vault.json
# as secret key "termux_ssh_password".
TERMUX_SSH_HOST=192.168.18.59
TERMUX_SSH_PORT=8022
TERMUX_SSH_USER=u0_a212
TERMUX_SSH_PASSWORD=

# LLM provider configuration
LLM_PROVIDER=auto
LLM_FALLBACK_ORDER=google,deepseek,openai,ollama
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Kaggle CLI (civilizaciones project)
# Session registered as user 'afarroc' (OAuth).
# API key stored in .env as KAGGLE_API_KEY.
KAGGLE_API_KEY=
